rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Single-user prototype: saved references are readable by the client,
    // writes go through the console or admin tooling. Tighten once auth lands.
    match /users/{userId}/transcripts/{transcriptId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
